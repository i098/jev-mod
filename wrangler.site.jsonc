{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-mod-site",
  "main": "apps/site/src/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "PUBLIC_URL": "https://jevmod.us" },
  "assets": {
    "directory": "docs",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "jevmod.us/*", "zone_name": "jevmod.us" },
    { "pattern": "www.jevmod.us/*", "zone_name": "jevmod.us" }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-mod-local-preview",
  "main": "apps/server/src/preview.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "PUBLIC_URL": "http://localhost:3102" },
  "d1_databases": [{ "binding": "DB", "database_name": "jev-mod-preview", "database_id": "11111111-1111-1111-1111-111111111111", "migrations_dir": "packages/db/migrations" }]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-mod",
  "main": "apps/server/src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "apps/web/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/healthz"] },
  "vars": { "PUBLIC_URL": "https://jev-mod.example.invalid", "BOT_ENABLED": "false" },
  "d1_databases": [{ "binding": "DB", "database_name": "jev-mod", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "packages/db/migrations" }],
  "durable_objects": { "bindings": [{ "name": "BOT", "class_name": "BotContainer" }] },
  "containers": [{ "class_name": "BotContainer", "image": "./apps/bot/Dockerfile", "image_build_context": ".", "max_instances": 1 }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotContainer"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}

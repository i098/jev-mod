NODE_ENV=development
PORT=7102
HOST=127.0.0.1
PUBLIC_URL=http://localhost:7102
# Set to the exact number of trusted reverse proxies in production.
TRUST_PROXY=0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Generate with: openssl rand -hex 32
SESSION_SECRET=
DATABASE_URL=mysql://jevmod:replace_me@127.0.0.1:3306/jev_mod
DATABASE_TLS=false
# A hard budget per guild, per minute. Excess messages are logged as skipped.
JEV_REQUESTS_PER_MINUTE=60
JEV_GLOBAL_REQUESTS_PER_MINUTE=600
